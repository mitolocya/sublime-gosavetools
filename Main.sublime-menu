[
    {
        "id": "tools",
        "children": [
            {
                "caption": "GoSaveTool",
                "children": [
                    { "caption": "Word Count", "command": "gosavetool_count" },
                    { "caption": "-" },
                    { "caption": "Subtitles to WebVTT", "command": "gosavetool_subtitles_convert", "args": { "to": "vtt" } },
                    { "caption": "Subtitles to SRT", "command": "gosavetool_subtitles_convert", "args": { "to": "srt" } },
                    { "caption": "Shift Subtitles…", "command": "gosavetool_subtitles_shift" },
                    { "caption": "Repair Subtitles", "command": "gosavetool_subtitles_repair" },
                    { "caption": "-" },
                    { "caption": "Title Case", "command": "gosavetool_case", "args": { "op": "title" } },
                    { "caption": "Sentence case", "command": "gosavetool_case", "args": { "op": "sentence" } },
                    { "caption": "UPPERCASE", "command": "gosavetool_case", "args": { "op": "upper" } },
                    { "caption": "lowercase", "command": "gosavetool_case", "args": { "op": "lower" } },
                    { "caption": "Clean Spaces", "command": "gosavetool_case", "args": { "op": "clean" } },
                    { "caption": "-" },
                    { "caption": "GoSaveTool Online Tools", "command": "open_url", "args": { "url": "https://www.gosavetool.com/" } }
                ]
            }
        ]
    },
    {
        "id": "preferences",
        "children": [
            {
                "caption": "Package Settings",
                "mnemonic": "P",
                "id": "package-settings",
                "children": [
                    {
                        "caption": "GoSaveTool",
                        "children": [
                            {
                                "caption": "Settings",
                                "command": "edit_settings",
                                "args": {
                                    "base_file": "${packages}/GoSaveTool/GoSaveTool.sublime-settings",
                                    "default": "{\n\t$0\n}\n"
                                }
                            },
                            {
                                "caption": "README",
                                "command": "open_file",
                                "args": { "file": "${packages}/GoSaveTool/README.md" }
                            }
                        ]
                    }
                ]
            }
        ]
    }
]
